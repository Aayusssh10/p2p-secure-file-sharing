VITE_SERVER_URL=http://localhost:4000

# Optional TURN relay for peers behind strict/symmetric NAT that STUN alone
# can't traverse (e.g. corporate or university networks). Leave unset to run
# STUN-only — peers stuck without a route will surface a "Still connecting…"
# diagnostic after 10s instead of hanging silently. Get credentials from a
# provider (Twilio, Xirsys, Cloudflare) or a self-hosted coturn instance.
# VITE_TURN_URL=turn:your-turn-host:3478
# VITE_TURN_USERNAME=
# VITE_TURN_CREDENTIAL=
