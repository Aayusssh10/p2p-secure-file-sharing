PORT=4000
CLIENT_URL=http://localhost:3000

# Optional. Room/transfer metrics (Phase 5) are persisted only if this is
# set and reachable — the signaling server starts and works normally
# without it, just with metrics logged as skipped. Local example:
# mongodb://127.0.0.1:27017/p2p-metrics — or an Atlas connection string.
MONGO_URI=

# Optional. Phase 6 (Gemini) features — file metadata summaries and
# friendly connection-status explanations — are skipped without this, no
# other functionality is affected. Get a free key from
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
